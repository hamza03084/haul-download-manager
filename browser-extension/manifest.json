{
  "manifest_version": 3,
  "name": "Haul Download Manager",
  "version": "2.0.0",
  "description": "Sends your downloads to the Haul desktop app: automatically when a download starts, or from the right-click menu of a link.",
  "key": "",
  "permissions": ["contextMenus", "downloads", "nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "action": { "default_title": "Haul Download Manager", "default_popup": "options.html" },
  "icons": { "128": "icon128.png" }
}
